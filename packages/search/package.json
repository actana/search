{
  "name": "@actana/search-core",
  "version": "0.1.0",
  "description": "actana/search core \u2014 the HTTPS API, the ingestion workers, the migrations, and the mTLS pairing that fronts them.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@actana/search": "workspace:*",
    "@actana/search-shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1015.0",
    "@aws-sdk/s3-request-presigner": "3.1015.0",
    "bullmq": "5.75.2",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.10.1",
    "ipaddr.js": "2.3.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.8",
    "unpdf": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
