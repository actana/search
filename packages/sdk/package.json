{
  "name": "@actana/search",
  "version": "0.1.0",
  "description": "The actana/search SDK \u2014 the typed client for a Search instance and the zod wire schemas it speaks.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "actana",
    "search",
    "knowledge-base",
    "rag",
    "sdk"
  ],
  "homepage": "https://github.com/actana/search/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/actana/search/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/search.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rehearse:pack": "node scripts/rehearse-npm-pack.mjs"
  },
  "dependencies": {
    "undici": "8.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@peculiar/x509": "1.14.3",
    "@types/node": "25.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
