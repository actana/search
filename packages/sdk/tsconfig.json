{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Relative imports inside this package carry their `.ts` extension so a
    // plain `node script.mjs` importing `@actana/search/…` resolves with no
    // bundler and no loader. Safe with `noEmit`, and the published build
    // rewrites the specifiers — see `tsconfig.build.json`.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
